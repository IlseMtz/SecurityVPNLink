+    private Limits readLimits(Network net) {
+        int limit = db.queryForObject("SELECT limite_equipos_usuario FROM red_vpn WHERE id_red=?", Integer.class, net.id());
+        Map<Long,Integer> usage = new LinkedHashMap<>();
+        db.query("""
+            SELECT id_usuario, COUNT(*) AS usados FROM dispositivo
+            WHERE id_red=? AND cupo_red IS NOT NULL GROUP BY id_usuario ORDER BY id_usuario
+            """, rs -> { usage.put(rs.getLong("id_usuario"), rs.getInt("usados")); }, net.id());
+        return new Limits(limit, usage, net.version());
+    }
+
+    public Limits limits(long id, long actor) {
+        return tx.execute(status -> readLimits(owned(id, actor)));
+    }
