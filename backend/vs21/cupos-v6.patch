+    public Limits updateLimits(long id, long actor, int limit, long version) {
+        return tx.execute(status -> {
+            Network net = owned(id, actor);
+            if (!Set.of("PENDIENTE", "ACTIVA").contains(net.estado()) ||
+                Boolean.TRUE.equals(db.queryForObject("SELECT bloqueo_operacion IS NOT NULL FROM red_vpn WHERE id_red=?", Boolean.class, id)))
+                throw error(HttpStatus.CONFLICT, "RED_NO_DISPONIBLE");
+            if (net.version() != version) throw error(HttpStatus.CONFLICT, "VERSION_DESACTUALIZADA");
+            Limits current = readLimits(net);
+            if (current.ocupadosPorUsuario().values().stream().anyMatch(used -> used > limit))
+                throw error(HttpStatus.CONFLICT, "LIMITE_INFERIOR_A_OCUPACION");
+            if (current.limiteEquiposUsuario() == limit) return current;
+            db.update("UPDATE red_vpn SET limite_equipos_usuario=?, version=version+1 WHERE id_red=?", limit, id);
+            audit(actor, id, "LIMITE_EQUIPOS_ACTUALIZADO", "RED_VPN", "Nuevo límite por usuario: " + limit);
+            return new Limits(limit, current.ocupadosPorUsuario(), net.version() + 1);
+        });
+    }
