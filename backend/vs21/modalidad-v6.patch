diff --git a/src/main/java/mx/securelink/backend/api/SplitProfile.java b/src/main/java/mx/securelink/backend/api/SplitProfile.java
new file mode 100644
index 0000000..0852549
--- /dev/null
+++ b/src/main/java/mx/securelink/backend/api/SplitProfile.java
@@ -0,0 +1,39 @@
+package mx.securelink.backend.api;
+
+import java.util.ArrayList;
+import java.util.List;
+
+final class SplitProfile {
+    private static final String FULL_ROUTES = "AllowedIPs = 0.0.0.0/0, ::/0";
+    private SplitProfile() {}
+
+    static String render(String full, String cidr) {
+        if (cidr == null || !cidr.matches("10\\.78\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})/28"))
+            throw new IllegalArgumentException("Subred de VPN inválida");
+        String[] octets = cidr.substring(0, cidr.length() - 3).split("\\.");
+        if (Integer.parseInt(octets[2]) > 255 || Integer.parseInt(octets[3]) > 240 ||
+            Integer.parseInt(octets[3]) % 16 != 0)
+            throw new IllegalArgumentException("Subred de VPN inválida");
+
+        List<String> lines = new ArrayList<>();
+        int routes = 0;
+        int addresses = 0;
+        for (String line : full.lines().toList()) {
+            if (line.startsWith("DNS = ")) continue;
+            if (line.equals(FULL_ROUTES)) {
+                line = "AllowedIPs = " + cidr;
+                routes++;
+            } else if (line.startsWith("Address = ")) {
+                int separator = line.indexOf(',');
+                if (separator < 0 || !line.substring(0, separator).matches("Address = 10\\.78\\.[0-9]{1,3}\\.[0-9]{1,3}/32"))
+                    throw new IllegalArgumentException("Dirección de perfil inválida");
+                line = line.substring(0, separator);
+                addresses++;
+            }
+            lines.add(line);
+        }
+        if (routes != 1 || addresses != 1)
+            throw new IllegalArgumentException("Formato de perfil no reconocido");
+        return String.join("\n", lines) + "\n";
+    }
+}
