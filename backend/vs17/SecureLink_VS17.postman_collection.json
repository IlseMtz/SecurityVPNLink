{
  "info": {
    "name": "SecureLink VS-17 Recursos internos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nero.northcentralus.cloudapp.azure.com/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "redId",
      "value": ""
    },
    {
      "key": "recursoId",
      "value": ""
    },
    {
      "key": "usuarioObjetivoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Listar catálogo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/administracion/recursos",
        "description": "ADMIN global. Consulta el catálogo."
      }
    },
    {
      "name": "Crear recurso",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/administracion/recursos",
        "description": "ADMIN global. Agrega un servicio interno.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laboratorio alterno\",\n  \"direccion\": \"172.30.77.11\",\n  \"protocolo\": \"TCP\",\n  \"puerto\": 80,\n  \"activo\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Editar o desactivar recurso",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/administracion/recursos/{{recursoId}}",
        "description": "ADMIN global. El cambio de destino o la desactivación retiran las concesiones.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laboratorio HTTP\",\n  \"direccion\": \"172.30.77.10\",\n  \"protocolo\": \"TCP\",\n  \"puerto\": 80,\n  \"activo\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Consultar recursos y concesiones de la red",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/redes/{{redId}}/recursos",
        "description": "Propietario de red. Consulta política guardada y sincronización reciente."
      }
    },
    {
      "name": "Conceder acceso o editar horario",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/redes/{{redId}}/recursos/concesiones",
        "description": "Propietario de red. Define el horario del usuario para un recurso.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recursoId\": {{recursoId}},\n  \"usuarioId\": {{usuarioObjetivoId}},\n  \"dias\": 31,\n  \"inicio\": \"09:00:00\",\n  \"fin\": \"18:00:00\",\n  \"zona\": \"America/Mexico_City\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Retirar concesión",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/redes/{{redId}}/recursos/{{recursoId}}/usuarios/{{usuarioObjetivoId}}/retiro",
        "description": "Propietario de red. Retira la política persistida y registra el cambio."
      }
    }
  ]
}
